# Copy this file to .env and fill in your own keys.
#   cp .env.example .env
# Then load it before running the skills:
#   set -a; . ./.env; set +a

# ElevenLabs - voice swap and text-to-speech (ugc_add_voice.py, voice_and_lipsync.py)
ELEVENLABS_API_KEY=

# WaveSpeed - lip-sync re-animation (voice_and_lipsync.py). Optional.
# Without it, voice is muxed onto the clip without re-syncing the mouth.
WAVESPEED_API_KEY=

# Google Gemini - vision QA and clip drift detection (ugc_clip_referee.py, ugc_claude_deliver.sh)
GEMINI_API_KEY=

# Optional: register your own cloned ElevenLabs voice by name without editing code.
#   format: name=voice_id
# UGC_MY_VOICE=me=xxxxxxxxxxxxxxxxxxxx

# Optional: point at a non-default Grok CLI binary if it is not on PATH.
# GROK_CLI_PATH=grok

# Optional (Telegram progress pings via task-monitor). Leave blank to disable.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_USER_ID=
